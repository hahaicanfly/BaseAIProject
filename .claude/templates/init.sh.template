# Goal: any new session/agent that runs this single script ends up with a working environment and self-verifies it. Any step failing = fix it before starting a task, don't start sick.
set -euo pipefail

echo "== 1/4 Environment requirement check =="
# {{Check language/tool versions, e.g.: node --version | grep -q 'v22' || { echo 'FAIL: requires Node 22'; exit 1; }}}

echo "== 2/4 Install dependencies (versions must be pinned by a lockfile) =="
# {{e.g.: npm ci / pip install -r requirements.lock / ./gradlew dependencies}}

echo "== 3/4 Build =="
# {{e.g.: npm run build / ./gradlew assembleDebug}}

echo "== 4/4 Verification command (Feedback subsystem; must match CLAUDE.md Quick Commands) =="
# {{e.g.: npm test && npm run lint}}

# Honest final message: if this script still contains its own unfilled
# template placeholders, an unconditional "init OK" would be a false-success
# message (see docs/research/2026-07-25-non-technical-accessibility.md Tier A).
# Check the script's own source for leftover placeholder slots before declaring
# success. The brace is built from two single characters so this detector line
# itself never contains the two-brace token it's searching for (else it would
# always match itself and the warning could never clear once slots are filled).
OPEN_BRACE='{'
if grep -qF "${OPEN_BRACE}${OPEN_BRACE}" "$0"; then
  echo "⚠ 尚未設定,不代表通過(此為範本原樣,請先照上面的 TODO 替換內容)"
else
  echo "init OK"
fi
